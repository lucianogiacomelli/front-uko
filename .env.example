# Supabase (Project Settings > API). Las variables VITE_ quedan en el bundle: solo claves públicas.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Conexión directa a Postgres para migraciones. Secreta: nunca con prefijo VITE_.
DB_CONNECTION=
# Opcional: si está cargada en Vercel, /api/keepalive solo responde al cron. Secreta: sin prefijo VITE_.
CRON_SECRET=
